function requestWithdrawal_(user, body) { const points = Number(body.points); const balanceType = body.balanceType === 'referral' ? 'referral' : 'regular'; const allowed = ['bKash','Nagad']; if (!Number.isInteger(points) || points <= 0 || (balanceType === 'regular' && points < Number(setting_('MINIMUM_WITHDRAW_POINTS')))) throw new Error(balanceType === 'referral' ? 'Enter a valid referral withdrawal amount.' : 'Withdrawal is below the minimum.'); if (allowed.indexOf(body.paymentMethod) < 0 || !/^01[3-9]\d{8}$/.test(body.accountNumber || '')) throw new Error('Invalid payment details.'); const lock = LockService.getScriptLock(); lock.waitLock(15000); try { const wallet = wallet_(user.userId); const available = balanceType === 'referral' ? Number(wallet.referralPoints || 0) : Number(wallet.availablePoints || 0); const reserved = balanceType === 'referral' ? Number(wallet.referralReservedPoints || 0) : Number(wallet.reservedPoints || 0); if (available < points) throw new Error('Insufficient points.'); const t = now_(); const withdrawal = insert_('Withdrawals', { withdrawalId: id_(), userId: user.userId, points: points, amountPaisa: Math.floor(points * Number(setting_('TAKA_PAISE_PER_UNIT')) / Number(setting_('POINTS_PER_UNIT'))), paymentMethod: body.paymentMethod, accountNumber: body.accountNumber, balanceType: balanceType, exchangeRateSnapshot: `${setting_('POINTS_PER_UNIT')}:${setting_('TAKA_PAISE_PER_UNIT')}`, status: 'pending', paymentReference: '', adminNote: '', processedBy: '', processedAt: '', createdAt: t, updatedAt: t }); const patch = balanceType === 'referral' ? { referralPoints: available - points, referralReservedPoints: reserved + points, updatedAt: t } : { availablePoints: available - points, reservedPoints: reserved + points, updatedAt: t }; update_('Wallets', 'userId', user.userId, patch); transaction_(user.userId, 'reserve', points, withdrawal.withdrawalId, `withdrawal-reserve-${withdrawal.withdrawalId}`, available, available - points, `${balanceType === 'referral' ? 'Referral ' : ''}Withdrawal reserve`); return withdrawal; } finally { lock.releaseLock(); } }
