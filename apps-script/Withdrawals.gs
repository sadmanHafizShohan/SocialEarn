function requestWithdrawal_(user, body) { const points = Number(body.points); const allowed = ['bKash','Nagad']; if (!Number.isInteger(points) || points < Number(setting_('MINIMUM_WITHDRAW_POINTS'))) throw new Error('Withdrawal is below the minimum.'); if (allowed.indexOf(body.paymentMethod) < 0 || !/^01[3-9]\d{8}$/.test(body.accountNumber || '')) throw new Error('Invalid payment details.'); const lock = LockService.getScriptLock(); lock.waitLock(15000); try { const wallet = wallet_(user.userId); if (Number(wallet.availablePoints) < points) throw new Error('Insufficient points.'); const before = Number(wallet.availablePoints); const t = now_(); const withdrawal = insert_('Withdrawals', { withdrawalId: id_(), userId: user.userId, points: points, amountPaisa: Math.floor(points * Number(setting_('TAKA_PAISE_PER_UNIT')) / Number(setting_('POINTS_PER_UNIT'))), paymentMethod: body.paymentMethod, accountNumber: body.accountNumber, exchangeRateSnapshot: `${setting_('POINTS_PER_UNIT')}:${setting_('TAKA_PAISE_PER_UNIT')}`, status: 'pending', paymentReference: '', adminNote: '', processedBy: '', processedAt: '', createdAt: t, updatedAt: t }); update_('Wallets', 'userId', user.userId, { availablePoints: before - points, reservedPoints: Number(wallet.reservedPoints) + points, updatedAt: t }); transaction_(user.userId, 'reserve', points, withdrawal.withdrawalId, `withdrawal-reserve-${withdrawal.withdrawalId}`, before, before - points, 'Withdrawal reserve'); return withdrawal; } finally { lock.releaseLock(); } }
