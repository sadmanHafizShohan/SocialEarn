function submit_(user, body) { if (!hasReferral_(user.userId)) throw new Error('Apply a referral code before submitting tasks.'); const task = task_(body.taskId, user); if (task.status !== 'active') throw new Error('Task is not available.'); if (hasAttemptedTask_(user.userId, body.taskId)) throw new Error('You have already attempted this task.'); const saved = saveScreenshot_(body, user.userId); const t = now_(); return insert_('Submissions', { submissionId: id_(), userId: user.userId, taskId: task.taskId, screenshotFileId: saved.id, screenshotMimeType: body.mimeType, screenshotSize: saved.size, pointsSnapshot: task.points, status: 'pending', rejectionReason: '', reviewedBy: '', reviewedAt: '', createdAt: t, updatedAt: t }); }
