function submit_(user, body) { if (!hasReferral_(user.userId)) throw new Error('Apply a referral code before submitting tasks.'); var task = task_(body.taskId, user, body.category); var category = taskCategory_(task, user, body.category); if (task.status !== 'active') throw new Error('Task is not available.'); if (hasAttemptedTask_(user.userId, body.taskId)) throw new Error('You have already attempted this task.'); var saved = saveScreenshot_(body, user.userId); var t = now_(); return insert_('Submissions', { submissionId: id_(), userId: user.userId, taskId: task.taskId, category: category, screenshotFileId: saved.id, screenshotMimeType: body.mimeType, screenshotSize: saved.size, pointsSnapshot: categoryConfig_(category).points, status: 'pending', rejectionReason: '', reviewedBy: '', reviewedAt: '', createdAt: t, updatedAt: t }); }
