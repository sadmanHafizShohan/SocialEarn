function hasAttemptedTask_(userId, taskId) { return records_('Submissions').some(function(submission) { return String(submission.userId) === String(userId) && String(submission.taskId) === String(taskId); }); }
function listTasks_(user) { if (!hasReferral_(user.userId)) throw new Error('Apply a referral code before accessing tasks.'); return records_('Tasks').filter(function(task) { return task.status === 'active' && (!task.expiryDate || new Date(task.expiryDate) >= new Date()) && hasUnlockedCategory_(user.userId, task.category) && !hasAttemptedTask_(user.userId, task.taskId); }).map(function(task) { task.remainingParticipants = Math.max(0, Number(task.maxParticipants) - Number(task.completedCount || 0)); return task; }); }
function task_(id, user) { const task = find_('Tasks', 'taskId', id); if (!task) throw new Error('Task not found.'); if (user && (!hasReferral_(user.userId) || !hasUnlockedCategory_(user.userId, task.category) || hasAttemptedTask_(user.userId, id))) throw new Error('Referral code is required, or this task is locked/already attempted.'); return task; }
function createTask_(user, body) { requireAdmin_(user); const category = String(body.category || ''); const config = categoryConfig_(category); const points = config.points; const maxParticipants = Number(body.maxParticipants); if (!String(body.title || '').trim() || !Number.isInteger(maxParticipants) || maxParticipants <= 0) throw new Error('Title and a positive participant limit are required.'); const t = now_(); return insert_('Tasks', Object.assign({}, body, { taskId: id_(), title: String(body.title).trim(), category: category, points: points, maxParticipants: maxParticipants, completedCount: 0, status: body.status === 'paused' ? 'paused' : 'active', createdBy: user.userId, createdAt: t, updatedAt: t })); }
