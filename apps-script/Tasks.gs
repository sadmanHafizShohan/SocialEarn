function taskCategories_(value) { var values = Array.isArray(value) ? value : String(value || '').split(','); return values.map(function(item) { return String(item).trim(); }).filter(function(item, index, list) { return item && list.indexOf(item) === index; }); }
function taskCategory_(task, user, requested) { var categories = taskCategories_(task.category); if (requested && categories.indexOf(String(requested)) < 0) throw new Error('Invalid task category.'); if (!user) return requested || categories[0]; var available = categories.filter(function(category) { return hasUnlockedCategory_(user.userId, category); }); if (!available.length || (requested && available.indexOf(String(requested)) < 0)) throw new Error('Referral code is required, or this task category is locked.'); return requested || available[available.length - 1]; }
function taskView_(task, user) { var categories = taskCategories_(task.category); var unlocked = user ? categories.filter(function(category) { return hasUnlockedCategory_(user.userId, category); }) : categories; var result = Object.assign({}, task, { availableCategories: categories, unlockedCategories: unlocked, categoryPoints: {} }); categories.forEach(function(category) { result.categoryPoints[category] = categoryConfig_(category).points; }); result.maxPoints = categories.reduce(function(max, category) { return Math.max(max, result.categoryPoints[category]); }, 0); return result; }
function hasAttemptedTask_(userId, taskId) { return records_('Submissions').some(function(submission) { return String(submission.userId) === String(userId) && String(submission.taskId) === String(taskId); }); }
function listTasks_(user) { if (!hasReferral_(user.userId)) throw new Error('Apply a referral code before accessing tasks.'); return records_('Tasks').filter(function(task) { return task.status === 'active' && (!task.expiryDate || new Date(task.expiryDate) >= new Date()); }).map(function(task) { var result = taskView_(task, user); result.remainingParticipants = Math.max(0, Number(task.maxParticipants) - Number(task.completedCount || 0)); return result; }); }
function task_(id, user, requestedCategory) { var task = find_('Tasks', 'taskId', id); if (!task) throw new Error('Task not found.'); if (user && !hasReferral_(user.userId)) throw new Error('Apply a referral code before accessing tasks.'); if (user && requestedCategory) taskCategory_(task, user, requestedCategory); return task; }
function createTask_(user, body) { requireAdmin_(user); var categories = taskCategories_(body.category); categories.forEach(categoryConfig_); var maxParticipants = Number(body.maxParticipants); if (!String(body.title || '').trim() || !categories.length || !Number.isInteger(maxParticipants) || maxParticipants <= 0) throw new Error('Title, at least one category, and a positive participant limit are required.'); var t = now_(); return insert_('Tasks', Object.assign({}, body, { taskId: id_(), title: String(body.title).trim(), category: categories.join(', '), points: Math.max.apply(null, categories.map(function(category) { return categoryConfig_(category).points; })), maxParticipants: maxParticipants, completedCount: 0, status: body.status === 'paused' ? 'paused' : 'active', createdBy: user.userId, createdAt: t, updatedAt: t })); }
