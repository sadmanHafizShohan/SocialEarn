function dashboard_(user) { requireAdmin_(user); const users = records_('Users'); const tasks = records_('Tasks'); const submissions = records_('Submissions'); const withdrawals = records_('Withdrawals'); const transactions = records_('Transactions'); return { totalUsers: users.length, activeUsers: users.filter(function(x) { return x.status === 'active'; }).length, blockedUsers: users.filter(function(x) { return x.status === 'blocked'; }).length, totalTasks: tasks.length, activeTasks: tasks.filter(function(x) { return x.status === 'active'; }).length, pendingSubmissions: submissions.filter(function(x) { return x.status === 'pending'; }).length, approvedSubmissions: submissions.filter(function(x) { return x.status === 'approved'; }).length, rejectedSubmissions: submissions.filter(function(x) { return x.status === 'rejected'; }).length, totalPointsIssued: transactions.filter(function(x) { return ['credit', 'referral'].indexOf(x.type) >= 0; }).reduce(function(total, item) { return total + Number(item.points || 0); }, 0), pendingWithdrawals: withdrawals.filter(function(x) { return x.status === 'pending'; }).length, paidWithdrawals: withdrawals.filter(function(x) { return x.status === 'paid'; }).length, totalPaidAmountPaisa: withdrawals.filter(function(x) { return x.status === 'paid'; }).reduce(function(total, item) { return total + Number(item.amountPaisa || 0); }, 0) }; }
function adminTasks_(user) { requireAdmin_(user); return records_('Tasks').reverse(); }
function adminUsers_(user) { requireAdmin_(user); return records_('Users').reverse(); }
function adminSubmissions_(user) { requireAdmin_(user); return records_('Submissions').reverse().map(function(item) { const account = find_('Users', 'userId', item.userId); const task = find_('Tasks', 'taskId', item.taskId); return Object.assign({}, item, { userName: account ? account.name : item.userId, userEmail: account ? account.email : '', taskTitle: task ? task.title : item.taskId }); }); }
function adminWithdrawals_(user) { requireAdmin_(user); return records_('Withdrawals').reverse().map(function(item) { const account = find_('Users', 'userId', item.userId); return Object.assign({}, item, { userName: account ? account.name : item.userId, userEmail: account ? account.email : '' }); }); }
function adminSettings_(user) { requireAdmin_(user); return records_('Settings'); }
function adminLogs_(user) { requireAdmin_(user); return records_('AdminLogs').reverse(); }
function adminTransactions_(user) { requireAdmin_(user); return records_('Transactions').reverse().map(function(item) { const account = find_('Users', 'userId', item.userId); return Object.assign({}, item, { userEmail: account ? account.email : item.userId }); }); }
function updateTask_(user, taskId, body) { requireAdmin_(user); if (!find_('Tasks', 'taskId', taskId)) throw new Error('Task not found.'); var categories = taskCategories_(body.category); categories.forEach(categoryConfig_); var maxParticipants = Number(body.maxParticipants); if (!categories.length || !Number.isInteger(maxParticipants) || maxParticipants <= 0) throw new Error('At least one category and a positive participant limit are required.'); return update_('Tasks', 'taskId', taskId, { title: String(body.title || ''), description: String(body.description || ''), platform: String(body.platform || ''), category: categories.join(', '), instructions: String(body.instructions || ''), referenceUrl: String(body.referenceUrl || ''), points: Math.max.apply(null, categories.map(function(category) { return categoryConfig_(category).points; })), maxParticipants: maxParticipants, startDate: String(body.startDate || ''), expiryDate: String(body.expiryDate || ''), status: String(body.status || 'active'), updatedAt: now_() }); }
function deleteTask_(user, taskId) { requireAdmin_(user); return update_('Tasks', 'taskId', taskId, { status: 'archived', updatedAt: now_() }); }
function updateUserStatus_(admin, userId, status) { requireAdmin_(admin); if (['active', 'blocked'].indexOf(status) < 0) throw new Error('Invalid user status.'); if (userId === admin.userId && status === 'blocked') throw new Error('You cannot block your own account.'); const result = update_('Users', 'userId', userId, { status: status, updatedAt: now_() }); insert_('AdminLogs', { logId: id_(), adminId: admin.userId, action: `user_${status}`, targetType: 'user', targetId: userId, details: '', createdAt: now_() }); return result; }
function updateSetting_(admin, key, value) { requireAdmin_(admin); if (!find_('Settings', 'settingKey', key)) throw new Error('Setting not found.'); return update_('Settings', 'settingKey', key, { settingValue: String(value), updatedAt: now_() }); }
function reviewWithdrawal_(admin, withdrawalId, body) { requireAdmin_(admin); const lock = LockService.getScriptLock(); lock.waitLock(15000); try { const withdrawal = find_('Withdrawals', 'withdrawalId', withdrawalId); if (!withdrawal || withdrawal.status !== 'pending') throw new Error('Withdrawal is no longer pending.'); if (['paid', 'rejected'].indexOf(body.status) < 0) throw new Error('Invalid withdrawal status.'); const wallet = wallet_(withdrawal.userId); const reserved = Number(wallet.reservedPoints); const points = Number(withdrawal.points); if (reserved < points) throw new Error('Reserved wallet balance is inconsistent.'); const t = now_(); const patch = { status: body.status, adminNote: String(body.adminNote || ''), paymentReference: String(body.paymentReference || ''), processedBy: admin.userId, processedAt: t, updatedAt: t }; if (body.status === 'paid') { update_('Wallets', 'userId', withdrawal.userId, { reservedPoints: reserved - points, totalWithdrawnPoints: Number(wallet.totalWithdrawnPoints) + points, updatedAt: t }); transaction_(withdrawal.userId, 'withdraw', points, withdrawalId, `withdrawal-paid-${withdrawalId}`, Number(wallet.availablePoints), Number(wallet.availablePoints), 'Paid withdrawal'); } else { update_('Wallets', 'userId', withdrawal.userId, { availablePoints: Number(wallet.availablePoints) + points, reservedPoints: reserved - points, updatedAt: t }); transaction_(withdrawal.userId, 'refund', points, withdrawalId, `withdrawal-refund-${withdrawalId}`, Number(wallet.availablePoints), Number(wallet.availablePoints) + points, 'Rejected withdrawal refund'); } const result = update_('Withdrawals', 'withdrawalId', withdrawalId, patch); insert_('AdminLogs', { logId: id_(), adminId: admin.userId, action: `withdrawal_${body.status}`, targetType: 'withdrawal', targetId: withdrawalId, details: String(body.adminNote || ''), createdAt: t }); return result; } finally { lock.releaseLock(); } }
